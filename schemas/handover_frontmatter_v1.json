{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/snflsknfkldnfs/session-bridge/schemas/handover_frontmatter_v1.json",
  "title": "Handover Frontmatter v1.0.0",
  "description": "YAML-Frontmatter schema for handover/<round>-<from>-<to>-<short-uuid>.md files. ADR_0029 \u00a74.3.",
  "type": "object",
  "required": [
    "pair_id",
    "round",
    "from",
    "to",
    "type",
    "timestamp",
    "worker_phase",
    "worker_focus",
    "status_verified_at",
    "references"
  ],
  "properties": {
    "pair_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "from": {
      "enum": [
        "advisor",
        "worker"
      ]
    },
    "to": {
      "enum": [
        "advisor",
        "worker"
      ]
    },
    "type": {
      "enum": [
        "initial-advice",
        "counter",
        "re-sync",
        "decision-lock",
        "pre-patch",
        "pre-flight",
        "execute",
        "verify",
        "status",
        "question"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "worker_phase": {
      "type": "string",
      "minLength": 1
    },
    "worker_focus": {
      "type": "string",
      "minLength": 1
    },
    "status_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "pointer",
          "verified"
        ],
        "properties": {
          "type": {
            "enum": [
              "transcript",
              "memory",
              "capability-probe",
              "filesystem",
              "shared-artifact"
            ]
          },
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "related_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^B-[0-9]+$"
      }
    },
    "related_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^D-[0-9]+$"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "condition",
          "action"
        ],
        "properties": {
          "condition": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "wallclock_estimate_min": {
      "type": "integer",
      "minimum": 0
    },
    "decided_by": {
      "enum": [
        "user",
        "consensus"
      ]
    },
    "pre_decision_verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "description": "NEU v0.1.4 (PB-003): Pflicht fuer type=decision-lock. Reverse-Questioning-Bank-Limit max 2 binaere Klaerungs-Fragen.",
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer",
          "timestamp"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "Konkrete binaere Klaerungs-Frage."
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "description": "User-Antwort."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "source_of_truth_locked": {
      "type": "array",
      "description": "NEU v0.1.10 (Pattern aus p11-R4-02 Cross-Project-Empirie): Bei versions-driftete Definitionen in Predecessor-Empirie Lock-Pflicht. Anti-Drift-#6 Cross-Project-Konsistenz. Pro Item: ref (Source-File/ADR/Definition), at_round (Lock-Round), reason (warum Lock).",
      "items": {
        "type": "object",
        "required": ["ref", "at_round"],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Source-of-Truth-Pointer (z.B. 'r_rl_sketch v3 §2.3' oder 'ADR_0046 K-Komponenten-Definition' oder absolute file path)."
          },
          "at_round": {
            "type": "integer",
            "minimum": 0,
            "description": "Round-Counter, in dem Lock erfolgt ist."
          },
          "reason": {
            "type": "string",
            "description": "Optional: Warum Lock erforderlich war (z.B. 'UGG-Skizze K-Index-Drift gegenueber operativer ADR_0046-Definition')."
          },
          "drift_against": {
            "type": "string",
            "description": "Optional: Pointer auf die abweichende Definition, gegen die Lock setzt (z.B. 'UGG-Skizze §2.3 K3+K4 vertauscht')."
          }
        },
        "additionalProperties": false
      }
    },
    "audit_anker": {
      "type": "array",
      "description": "NEU v0.1.12 (Pattern aus p12 Anti-Drift-#7): Audit-Befund-Carry-Over-Konsistenz. Pro Patch/Edit/Decision ein Audit-Anker mit Pointer auf Original-Audit-Recommendation. Ermoeglicht Cross-Bridge-Audit-Trace ohne Spec-Inhalt-Verlust. Format kompatibel zu HTML-Inline-Comment-Pattern: <!-- Audit-Anker: P0-X / AUDIT_RECOMMENDATION §1 -->.",
      "items": {
        "type": "object",
        "required": ["anchor_id", "source_ref"],
        "properties": {
          "anchor_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]?-[A-Za-z0-9_-]+$",
            "description": "Audit-Anker-ID. Format: <Kategorie>-<Item> (z.B. 'P0-A1', 'P1-B5', 'R5-NEU-2'). Pflicht-unique innerhalb eines handover."
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Pointer auf Original-Audit-Recommendation (z.B. 'AUDIT_RECOMMENDATION §1', 'p9-schsch-architektur-import/audit/bundle.md §3.2', absolute path)."
          },
          "patch_location": {
            "type": "string",
            "description": "Optional: Wo Anker im Output-Artefakt verankert ist (z.B. 'EG-Spec §2.X.5', 'commands/bridge-init.md §Pre-Flight')."
          },
          "category": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3", "RISK", "DEFERRED", "INFO"],
            "description": "Audit-Priorität-Kategorie. P0=Critical-Block, P1=High, P2=Medium, P3=Low, RISK=Risk-Klausel, DEFERRED=Phase-Backlog, INFO=Tracking-Only."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "pre-patch",
              "execute",
              "verify"
            ]
          }
        }
      },
      "then": {
        "required": [
          "acceptance_criteria"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "execute"
          }
        }
      },
      "then": {
        "required": [
          "rollback_triggers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "pre-patch",
              "execute"
            ]
          }
        }
      },
      "then": {
        "required": [
          "wallclock_estimate_min"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision-lock"
          }
        }
      },
      "then": {
        "required": [
          "decided_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision-lock"
          }
        }
      },
      "then": {
        "required": [
          "pre_decision_verification"
        ],
        "description": "NEU v0.1.4 (PB-003): decision-lock-Handover MUSS pre_decision_verification mit 1-2 Eintraegen haben."
      }
    }
  ]
}